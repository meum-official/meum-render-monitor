# Keep HOST at loopback when no authentication/reverse proxy is configured.
HOST=127.0.0.1
PORT=8310
INTERVAL_MINUTES=60
# Optional absolute Chromium/Edge executable; otherwise installed Chromium is used.
# PLAYWRIGHT_CHROMIUM_EXECUTABLE=C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe
# External binding requires BOTH values below, or an authenticated reverse proxy
# with TRUST_AUTH_PROXY=1 and no direct access to this port.
# MONITOR_USER=meum
# MONITOR_PASSWORD=use-a-long-unique-password
# CONFIG_PATH=./config.json
